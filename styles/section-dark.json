{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Dark ground",
	"slug": "section-dark",
	"blockTypes": [
		"core/group",
		"core/columns",
		"core/column",
		"core/cover",
		"core/media-text"
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--dark)",
			"text": "var(--wp--preset--color--overlay)"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--overlay)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--overlay)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--overlay)"
					}
				}
			}
		}
	}
}
