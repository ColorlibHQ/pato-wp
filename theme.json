{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"name": "Base",
					"slug": "base",
					"color": "#ffffff"
				},
				{
					"name": "Surface",
					"slug": "surface",
					"color": "#faf7f4"
				},
				{
					"name": "Contrast",
					"slug": "contrast",
					"color": "#1a1513"
				},
				{
					"name": "Muted",
					"slug": "muted",
					"color": "#5f5853"
				},
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#d41b22"
				},
				{
					"name": "Primary deep",
					"slug": "primary-deep",
					"color": "#a8141a"
				},
				{
					"name": "Flame",
					"slug": "flame",
					"color": "#ec1d25"
				},
				{
					"name": "Accent",
					"slug": "accent",
					"color": "#b8863b"
				},
				{
					"name": "Dark",
					"slug": "dark",
					"color": "#15100e"
				},
				{
					"name": "Divider",
					"slug": "divider",
					"color": "#e2d9d1"
				}
			],
			"gradients": [
				{
					"name": "Ember",
					"slug": "ember",
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-deep) 100%)"
				},
				{
					"name": "Dusk",
					"slug": "dusk",
					"gradient": "linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.78) 100%)"
				},
				{
					"name": "Scrim",
					"slug": "scrim",
					"gradient": "linear-gradient(0deg, rgba(0,0,0,0.86) 0%, rgba(0,0,0,0.72) 45%, rgba(0,0,0,0.22) 100%)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Montserrat",
					"fontFamily": "Montserrat, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD",
							"src": [
								"file:./assets/fonts/montserrat/montserrat-normal-latin.woff2"
							]
						},
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF",
							"src": [
								"file:./assets/fonts/montserrat/montserrat-normal-latin-ext.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Poppins",
					"fontFamily": "Poppins, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Poppins",
							"fontStyle": "normal",
							"fontWeight": "300",
							"fontDisplay": "swap",
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD",
